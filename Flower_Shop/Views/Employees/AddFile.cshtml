@{
    ViewData["Title"] = "Add Employee File";
}

<div class="container mt-5">

    <h2>Add Employee File</h2>

    <form asp-action="AddFile" method="post" enctype="multipart/form-data">

        <input type="hidden" name="employeeId" value="@ViewBag.Employee.Id" />

        <div class="mb-3">
            <label class="form-label">File Name</label>
            <input type="text" name="name" class="form-control" placeholder="Example: CV" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Choose File</label>
            <input type="file" name="file" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">
            Upload File
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>
