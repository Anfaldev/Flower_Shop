    <Folder Include="wwwroot\images\employees\" />
    <Folder Include="wwwroot\files\" />
    <Folder Include="wwwroot\files\employees\" />
    <Folder Include="Views\Employees\" />
    <Folder Include="Views\OrderItems\" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\images\" />
    <Content Remove="wwwroot\images\products\" />
    <Content Remove="wwwroot\images\employees\" />
    <Content Remove="wwwroot\files\" />
    <Content Remove="wwwroot\files\employees\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flower_Shop.Domain\Flower_Shop.Domain.csproj">
