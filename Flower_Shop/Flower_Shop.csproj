      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BCrypt.Net-Core" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Views\Categories\" />
    <None Remove="Views\Products\" />
    <None Remove="Views\Customers\" />
    <None Remove="Views\Orders\" />
    <None Remove="Views\Roles\" />
    <None Remove="Views\Permissions\" />
    <None Remove="Views\Users\" />
    <None Remove="Views\Accounts\" />
    <None Remove="Views\Employees\" />
    <None Remove="Views\OrderItems\" />
  </ItemGroup>
