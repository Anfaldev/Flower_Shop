@model IEnumerable<Flower_Shop.Dtos.CustomersDtos.CustomerDto>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Customers</h2>

        <a asp-action="Create" class="btn btn-primary">
            Create New Customer
        </a>
    </div>

    <table class="table table-bordered table-hover">

        <thead class="table-primary">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-uid="@item.UID"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-uid="@item.UID"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>