<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <meta name="description"
          content="Flower Shop Management System" />

    <meta name="author" content="" />

    <title>@ViewData["Title"] - Flower Shop</title>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css"
          rel="stylesheet" />

    <link href="~/template/css/styles.css"
          rel="stylesheet" />

    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
            crossorigin="anonymous"></script>

</head>

<body class="sb-nav-fixed">

    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">

        <a class="navbar-brand ps-3"
           asp-controller="Home"
           asp-action="Index">

            Flower Shop

        </a>

        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0"
                id="sidebarToggle"
                type="button">

            <i class="fas fa-bars"></i>

        </button>

        <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">

            <div class="input-group">

                <input class="form-control"
                       type="text"
                       placeholder="Search for..."
                       aria-label="Search for..."
                       aria-describedby="btnNavbarSearch" />

                <button class="btn btn-primary"
                        id="btnNavbarSearch"
                        type="button">

                    <i class="fas fa-search"></i>

                </button>

            </div>

        </form>

        <!-- Account Dropdown -->

        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">

            <li class="nav-item dropdown">

                <a class="nav-link dropdown-toggle"
                   id="navbarDropdown"
                   href="#"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">

                    <i class="fas fa-user fa-fw"></i>

                </a>

                <ul class="dropdown-menu dropdown-menu-end"
                    aria-labelledby="navbarDropdown">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li>

                            <span class="dropdown-item-text">

                                @User.Identity.Name

                            </span>

                        </li>

                        <li>

                            <hr class="dropdown-divider" />

                        </li>

                        <li>

                            <form asp-controller="Accounts"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="dropdown-item">

                                    <i class="fas fa-sign-out-alt me-2"></i>

                                    Logout

                                </button>

                            </form>

                        </li>
                    }
                    else
                    {
                        <li>

                            <a class="dropdown-item"
                               asp-controller="Accounts"
                               asp-action="Login">

                                <i class="fas fa-sign-in-alt me-2"></i>

                                Login

                            </a>

                        </li>
                    }

                </ul>

            </li>

        </ul>

    </nav>


    <div id="layoutSidenav">

        <div id="layoutSidenav_nav">

            <nav class="sb-sidenav accordion sb-sidenav-dark"
                 id="sidenavAccordion">

                <div class="sb-sidenav-menu">

                    <div class="nav">

                        <!-- Core -->

                        <div class="sb-sidenav-menu-heading">
                            Core
                        </div>

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-tachometer-alt"></i>

                            </div>

                            Dashboard

                        </a>


                        <!-- Shop -->

                        <div class="sb-sidenav-menu-heading">
                            Shop
                        </div>

                        <a class="nav-link"
                           asp-controller="Categories"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-tags"></i>

                            </div>

                            Categories

                        </a>


                        <a class="nav-link"
                           asp-controller="Products"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-box"></i>

                            </div>

                            Products

                        </a>


                        <a class="nav-link"
                           asp-controller="Customers"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-users"></i>

                            </div>

                            Customers

                        </a>


                        <a class="nav-link"
                           asp-controller="Orders"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-shopping-cart"></i>

                            </div>

                            Orders

                        </a>


                        <!-- Access Management -->

                        <div class="sb-sidenav-menu-heading">
                            Access Management
                        </div>


                        <a class="nav-link"
                           asp-controller="Employees"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-user"></i>

                            </div>

                            Employees

                        </a>


                        <a class="nav-link"
                           asp-controller="Users"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-user"></i>

                            </div>

                            Users

                        </a>


                        <a class="nav-link"
                           asp-controller="Roles"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-user-shield"></i>

                            </div>

                            Roles

                        </a>


                        <a class="nav-link"
                           asp-controller="Permissions"
                           asp-action="Index">

                            <div class="sb-nav-link-icon">

                                <i class="fas fa-key"></i>

                            </div>

                            Permissions

                        </a>


                        <!-- Account -->

                        <div class="sb-sidenav-menu-heading">
                            Account
                        </div>


                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Accounts"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="nav-link btn btn-link text-start w-100">

                                    <div class="sb-nav-link-icon">

                                        <i class="fas fa-sign-out-alt"></i>

                                    </div>

                                    Logout

                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="nav-link"
                               asp-controller="Accounts"
                               asp-action="Login">

                                <div class="sb-nav-link-icon">

                                    <i class="fas fa-sign-in-alt"></i>

                                </div>

                                Login

                            </a>
                        }

                    </div>

                </div>


                <!-- Footer -->

                <div class="sb-sidenav-footer">

                    <div class="small">

                        Flower Shop

                    </div>

                    Management System

                </div>

            </nav>

        </div>


        <div id="layoutSidenav_content">

            <main>

                <div class="container-fluid px-4">

                    @RenderBody()

                </div>

            </main>


            <!-- Footer -->

            <footer class="py-4 bg-light mt-auto">

                <div class="container-fluid px-4">

                    <div class="d-flex align-items-center justify-content-between small">

                        <div class="text-muted">

                            Copyright &copy; Flower Shop 2026

                        </div>

                        <div>

                            <a href="#">
                                Privacy Policy
                            </a>

                            &middot;

                            <a href="#">
                                Terms &amp; Conditions
                            </a>

                        </div>

                    </div>

                </div>

            </footer>

        </div>

    </div>


    <!-- Scripts -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>

    <script src="~/template/js/scripts.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js"
            crossorigin="anonymous"></script>

    <script src="~/template/assets/demo/chart-area-demo.js"></script>

    <script src="~/template/assets/demo/chart-bar-demo.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"
            crossorigin="anonymous"></script>

    <script src="~/template/js/datatables-simple-demo.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>